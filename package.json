{
  "name": "quiz-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"node --watch server/src/index.ts --api-only\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/src/index.ts --api-only",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "start": "node server/src/index.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "review-doc": "node scripts/generate-review.mjs",
    "sounds": "node scripts/generate-sounds.mjs",
    "delete-score": "node server/src/scripts/delete-score.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.18"
  }
}
